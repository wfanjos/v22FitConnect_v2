# Copie para .env e preencha. Chaves públicas (vão dentro do app); segredos nunca entram aqui.
# Sentry: Settings > Projects > (projeto) > Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=
# PostHog (região EU): Project settings > Project API key (começa com phc_)
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
